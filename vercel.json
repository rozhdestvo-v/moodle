{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,PATCH,OPTIONS,DELETE"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "ngrok-skip-browser-warning,Content-Type,Accept,Access-Control-Allow-Headers"
        }
      ]
    }
  ]
}
